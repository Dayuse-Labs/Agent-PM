# hotel_search_agent — local dev env (copy to repo-root .env, gitignored).

# Modèle via LiteLLM uniquement (D3) — slug LiteLLM, jamais de SDK cloud direct.
DAYUSE_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=sk-...

# MCP_B2C (Streamable HTTP, lecture seule Elasticsearch).
# Le MCP accessible en dev pointe sur l'ES de STAGING : OK pour développer,
# INTERDIT pour le shadow-run/parité (exige ES prod, cf. plan Ph3.3).
MCP_B2C_URL=https://mcp-b2c-staging.example.internal/mcp
MCP_B2C_AUTH_TOKEN=
# Budget MCP propriété de cette feuille (défaut 5 s, circuit-breaker en S4).
HOTEL_SEARCH_MCP_TIMEOUT_SECONDS=5.0

# Exposition A2A. A2A_HOST = hôte joignable par les pairs (écrit dans la carte).
A2A_HOST=localhost
PORT=8101
# D7 : bearer statique intérimaire VÉRIFIÉ par serve.py — fail-closed au boot si absent/vide.
# En local n'importe quel token non vide convient ; en déploiement, secret Railway.
A2A_BEARER_TOKEN=local-dev-token

# OBS1 — Langfuse (traces d'audit, self-hosted EU). Les DEUX clés absentes ⇒ inerte.
# Clés à créer dans l'UI Langfuse (un seul projet pour les 3 services).
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_BASE_URL=https://langfuse-web-production-272b.up.railway.app
#LANGFUSE_TRACING_ENVIRONMENT=development
# OBS2 — sha git court du déploiement courant. Zéro code : le SDK Langfuse lit
# cette variable lui-même (même mécanisme que LANGFUSE_TRACING_ENVIRONMENT),
# sur les 3 services. Permet de comparer un avant/après déploiement sur les
# mêmes métriques (latence, coût, taux de guard) dans les dashboards.
#LANGFUSE_RELEASE=$(git rev-parse --short HEAD)
